{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-state.schema.json",
  "title": "Compute Gate State",
  "description": "追蹤一個 experiment 目前停在 Compute Gate 的哪一級、怎麼走到這裡的。這是以原子替換更新的狀態投影；每次判定只可 append 一筆 history，既有 history 不得修改或刪除。",
  "type": "object",
  "required": ["experiment_id", "current_level", "history", "updated_at"],
  "properties": {
    "experiment_id": { "type": "string" },
    "current_level": {
      "type": ["string", "null"],
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5", null],
      "description": "null 代表這個 experiment 還沒申請過任何等級，下一次必須申請 L0"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "status", "decided_at", "reason", "evidence_eligible", "evidence_reasons"],
        "properties": {
          "level": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"] },
          "stage": {
            "type": "string",
            "enum": ["preflight", "pilot", "main", "replication", "independent_review"],
            "description": "這一級對應的研究階段，由 Contract 的 compute_cascade 決定。stage 是研究階段，level 是花多少算力"
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "aborted"],
            "description": "failed：這次沒過，可以帶更多證據重新申請同一級；aborted：abort_rule 觸發，這條路線視為終止，不是叫你重試"
          },
          "decided_at": { "type": "string", "format": "date-time" },
          "reason": { "type": "string" },
          "checks": {
            "type": "array",
            "default": [],
            "description": "這次判定實際做了哪些檢查、各自的結果。決定要能回溯到數字，不能只留一句結論",
            "items": {
              "type": "object",
              "required": ["kind", "passed", "detail"],
              "properties": {
                "kind": { "type": "string", "enum": ["sequence", "evidence", "budget", "promotion", "abort"] },
                "passed": { "type": "boolean" },
                "detail": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "run_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
          "evidence_eligible": { "type": "boolean" },
          "evidence_reasons": { "type": "array", "items": { "type": "string" }, "default": [] }
        },
        "additionalProperties": false
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
