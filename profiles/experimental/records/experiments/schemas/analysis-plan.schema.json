{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-plan.schema.json",
  "title": "Comparison Analysis Plan",
  "type": "object",
  "required": ["estimands", "estimators", "decision_rules"],
  "properties": {
    "estimands": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "metric", "population", "conditions", "scale", "summary_measure", "orientation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "metric": { "type": "string" },
          "population": { "type": "string", "minLength": 1 },
          "conditions": { "type": "object" },
          "scale": { "type": "string", "minLength": 1 },
          "summary_measure": { "enum": ["difference", "difference_in_differences"] },
          "orientation": { "const": "treatment_minus_baseline" }
        },
        "additionalProperties": false
      }
    },
    "estimators": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "estimand_ref", "type", "method_ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "estimand_ref": { "type": "string" },
          "type": { "enum": ["difference", "difference_in_differences", "joint_cluster_bootstrap"] },
          "method_ref": { "type": "string", "minLength": 1 },
          "cells": {
            "type": "object",
            "required": ["control_pre", "control_post", "treatment_pre", "treatment_post"],
            "additionalProperties": {
              "type": "object", "required": ["run_role", "metric"],
              "properties": { "run_role": { "enum": ["baseline", "treatment"] }, "metric": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "component_a": { "type": "string" },
          "component_b": { "type": "string" },
          "uncertainty": {
            "type": "object",
            "required": ["confidence_level", "interval_method", "resampling_unit", "replicates", "seed", "method_reference"],
            "properties": {
              "confidence_level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
              "interval_method": { "const": "percentile" },
              "resampling_unit": { "type": "string", "minLength": 1 },
              "strata": { "type": "array", "items": { "type": "string" } },
              "replicates": { "type": "integer", "minimum": 1 },
              "seed": { "type": "integer" },
              "method_reference": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "decision_rules": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "estimand_ref", "type", "null_value"],
            "properties": {
              "id": { "type": "string" }, "estimand_ref": { "type": "string" },
              "type": { "const": "superiority" }, "null_value": { "type": "number" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "estimand_ref", "type", "equivalence_margin"],
            "properties": {
              "id": { "type": "string" }, "estimand_ref": { "type": "string" },
              "type": { "const": "equivalence" },
              "equivalence_margin": {
                "type": "object",
                "required": ["lower", "upper", "scale", "interval_confidence_level", "interval_method", "boundary"],
                "properties": {
                  "lower": { "type": "number" }, "upper": { "type": "number" },
                  "scale": { "type": "string" },
                  "interval_confidence_level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
                  "interval_method": { "type": "string" },
                  "boundary": { "enum": ["inclusive", "exclusive"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
