{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comparison-result.schema.json",
  "title": "Comparison Result",
  "description": "compare-runs 的固定輸出格式，供 claim-audit 與 UI 直接讀取，不必各自重新解析兩個 Run Envelope。三種判斷刻意分開：structurally_comparable 問「兩邊在講同一件事嗎」、controlled_variables_match 問「除了宣告的變因，其他條件真的一樣嗎」、confounded 問「差異嚴重到不能歸因嗎」。三者都由程式算，不接受 LLM 直接決定。只有 comparison_valid 為 true 時，metrics 底下的差異才算數。",
  "type": "object",
  "required": [
    "experiment_id", "run_a", "run_b", "generated_at",
    "comparability", "structurally_comparable", "controlled_variables_match",
    "differences", "comparison_valid", "confounded", "metrics",
    "evidence_eligible", "evidence_reasons"
  ],
  "properties": {
    "experiment_id": { "type": "string" },
    "run_a": { "type": "string" },
    "run_b": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "comparability": {
      "type": "object",
      "required": ["dimensions", "declared_variable"],
      "properties": {
        "dimensions": {
          "type": "object",
          "description": "key 是檢查維度（dataset/evaluation_set/model/budget/controlled_variables 裡的每一項），value 是判定。這裡保留 PASS 與 SKIPPED，因為「檢查過而且一致」跟「根本沒檢查」不是同一回事",
          "additionalProperties": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "enum": ["PASS", "DIFF", "SKIPPED"] },
              "run_a_value": {},
              "run_b_value": {}
            },
            "additionalProperties": false
          }
        },
        "declared_variable": {
          "type": "object",
          "description": "Contract 裡宣告的 treatment.variable 實際比對結果",
          "properties": {
            "name": { "type": ["string", "null"] },
            "run_a_value": {},
            "run_b_value": {},
            "changed": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "structurally_comparable": {
      "type": "boolean",
      "description": "兩邊是否至少有一個指標用同一套定義算出來。全部指標都對不上時，這次比較沒有共同基準——這是 invalid 但不是 confounded"
    },
    "controlled_variables_match": {
      "type": "boolean",
      "description": "除了宣告的 treatment 變因，config、data、model、prompt、evaluator 是否都相同"
    },
    "differences": {
      "type": "array",
      "default": [],
      "description": "兩邊實際不同的具名欄位，帶分類與嚴重度。這是「什麼不一樣」的唯一清單；comparability.dimensions 只記每個維度的判定結果",
      "items": {
        "type": "object",
        "required": ["category", "key", "run_a_value", "run_b_value", "severity"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["config", "data", "model", "prompt", "evaluator", "sample", "unknown"]
          },
          "key": { "type": "string" },
          "run_a_value": {},
          "run_b_value": {},
          "severity": {
            "type": "string",
            "enum": ["blocking", "warning", "informational"],
            "description": "blocking 代表這個差異讓效應無法歸因。declared 變因本身的差異是 informational——那正是實驗要測的東西"
          },
          "declared": {
            "type": "boolean",
            "default": false,
            "description": "true 代表這個差異就是 Contract 宣告的實驗變因"
          }
        },
        "additionalProperties": false
      }
    },
    "comparison_valid": {
      "type": "boolean",
      "description": "false 時，metrics 底下的 computed 一律為 false，不得引用這次比較下因果性結論"
    },
    "confounded": { "type": "boolean" },
    "confounded_reasons": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["definition_consistent", "computed"],
        "properties": {
          "definition_consistent": { "type": "boolean" },
          "computed": { "type": "boolean" },
          "baseline": { "type": ["number", "null"] },
          "treatment": { "type": ["number", "null"] },
          "absolute_diff": { "type": ["number", "null"] },
          "relative_diff": { "type": ["number", "null"] }
        },
        "additionalProperties": false
      }
    },
    "evidence_eligible": { "type": "boolean" },
    "evidence_reasons": { "type": "array", "items": { "type": "string" }, "default": [] },
    "diagnostic_suggestions": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "可由 agent 提出的異常解釋與下一步建議。刻意跟 validity 欄位分開——建議永遠不得改變 comparison_valid 或 confounded"
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "additionalProperties": false
}
