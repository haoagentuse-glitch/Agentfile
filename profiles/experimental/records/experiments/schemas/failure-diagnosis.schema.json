{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "failure-diagnosis.schema.json",
  "title": "Failure Diagnosis",
  "description": "一次失敗的結構化診斷。生命週期的終態（execution_failed、pilot_failed、confounded、inconclusive……）只留一句 reason，回頭看時說不出當初排除過什麼；這份紀錄補上那一段。\n\n最重要的是兩欄分開：deterministic_facts 是從紀錄讀出來、每條都指得出來源的事實；hypotheses 是 agent 的推測。混寫的話，讀的人分不出哪些是已知、哪些是猜的，而猜測會隨著時間被當成事實。",
  "type": "object",
  "required": ["diagnosis_id", "experiment_id", "diagnosed_at", "subject", "deterministic_facts", "hypotheses", "cheapest_next_test"],
  "properties": {
    "diagnosis_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "experiment_id": { "type": "string" },
    "diagnosed_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "description": "在診斷什麼。指到具體紀錄，不是「這個實驗好像怪怪的」",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["run", "comparison", "gate", "claim"] },
        "ref": { "type": "string", "format": "project-ref" }
      },
      "additionalProperties": false
    },
    "deterministic_facts": {
      "type": "array",
      "minItems": 1,
      "description": "從紀錄讀出來的事實。每條都要指得出來源——說不出來源的就是推測，該放 hypotheses",
      "items": {
        "type": "object",
        "required": ["fact", "source_ref"],
        "properties": {
          "fact": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "format": "project-ref" },
          "locator": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "description": "agent 的推測。每個標一種失敗分類與把握程度",
      "items": {
        "type": "object",
        "required": ["id", "failure_class", "statement", "confidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "failure_class": { "$ref": "failure-taxonomy.schema.json#/$defs/failureClass" },
          "statement": { "type": "string", "minLength": 1 },
          "confidence": { "$ref": "failure-taxonomy.schema.json#/$defs/confidence" },
          "discriminating_observation": {
            "type": "string",
            "description": "看到什麼就能把這個假設跟其他假設分開"
          }
        },
        "additionalProperties": false
      }
    },
    "excluded_classes": {
      "type": "array",
      "default": [],
      "description": "已經排除的失敗分類與排除依據。hypothesis_refuted 是正式結論，不是兜底選項——要用它就得先說明其他分類怎麼排除的",
      "items": {
        "type": "object",
        "required": ["failure_class", "reason"],
        "properties": {
          "failure_class": { "$ref": "failure-taxonomy.schema.json#/$defs/failureClass" },
          "reason": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "format": "project-ref" }
        },
        "additionalProperties": false
      }
    },
    "cheapest_next_test": {
      "type": "object",
      "description": "能分辨上述假設的最便宜測試",
      "required": ["description", "distinguishes"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "command": {
          "type": "string",
          "description": "可複製的單一指令。跑過但沒有名字的操作不算可重現"
        },
        "distinguishes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "這個測試能分開哪幾個 hypotheses.id。不能分辨假設的測試不算下一步，只是再跑一次"
        },
        "estimated_cost": { "type": "string" }
      },
      "additionalProperties": false
    },
    "producer": { "$ref": "provenance.schema.json#/$defs/producer" }
  },
  "additionalProperties": false
}
