  "controlled_variables": ["dataset", "model", "seed"],
  "primary_metric": "recall_at_10",
  "secondary_metrics": ["latency_ms"],
  "decision_rule": "recall_at_10 絕對提升 > 0.03 才算成功",
  "compute_budget": { "pilot_max_minutes": 30, "pilot_max_samples": 500 },
  "abort_rule": "latency_ms p95 超過 800ms 就中止",
